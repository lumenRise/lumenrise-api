# Allowed values: "development", "test", "production"
NODE_ENV=development

# HTTP port the server listens on.
PORT=5000

# Logging verbosity.
# Allowed values: "fatal", "error", "warn", "info", "debug", "trace", "silent"
LOG_LEVEL=info

# MongoDB connection string.
DB_URI=mongodb://127.0.0.1:27017?replicaSet=rs0&directConnection=true

# MongoDB database name.
DB_NAME=lumenrise

# RabbitMQ address for background job dispatch.
RABBITMQ_URL=amqp://127.0.0.1:5672

# Browser client origin allowed to send credentialed requests.
CLIENT_ORIGIN=http://localhost:5173

# Number of days a Lumenrise session remains valid.
SESSION_TTL_DAYS=30

# Secret for signing wallet-auth JWTs; required in production.
AUTH_JWT_SECRET=super-secret-jwt-signing-key

# Stellar network bound to wallet authentication messages.
# Allowed values: "testnet", "public"
STELLAR_AUTH_NETWORK=testnet

# GitHub OAuth application client ID.
GITHUB_CLIENT_ID=github-client-id

# GitHub OAuth application client secret.
GITHUB_CLIENT_SECRET=github-client-secret

# GitHub OAuth callback URL registered for the application.
GITHUB_CALLBACK_URL=http://localhost:5000/v1/oauth/github/callback

# X OAuth 2.0 application client ID.
X_CLIENT_ID=x-client-id

# X OAuth 2.0 application client secret.
X_CLIENT_SECRET=x-client-secret

# X OAuth callback URL registered for the application.
X_CALLBACK_URL=http://localhost:5000/v1/oauth/x/callback

# Horizon base URL used for read-only Stellar account lookups.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
STELLAR_TESTNET_HOME_DOMAIN=testnet.lumenrise.app
STELLAR_PUBLIC_HOME_DOMAIN=lumenrise.app

# 64-character hexadecimal key used to encrypt provider credentials.
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
